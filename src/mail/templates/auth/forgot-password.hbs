<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reset Your Password</title>
  <style>
    body {
      margin: 0;
      padding: 0;
      width: 100% !important;
      background-color: #f8fafc;
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      -webkit-font-smoothing: antialiased;
    }

    table {
      border-collapse: collapse;
    }

    .wrapper {
      width: 100%;
      table-layout: fixed;
      background-color: #f8fafc;
      padding: 40px 0;
    }

    .container {
      width: 100%;
      max-width: 520px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 12px;
      border: 1px solid #e2e8f0;
      box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
      overflow: hidden;
    }

    .content {
      padding: 40px 32px;
    }

    .logo {
      font-size: 20px;
      font-weight: 700;
      color: #0f172a;
      letter-spacing: -0.5px;
      margin-bottom: 32px;
    }

    .title {
      font-size: 22px;
      font-weight: 700;
      color: #0f172a;
      margin-top: 0;
      margin-bottom: 12px;
      line-height: 1.3;
    }

    .text {
      font-size: 15px;
      line-height: 1.6;
      color: #475569;
      margin-top: 0;
      margin-bottom: 24px;
    }

    .code-container {
      background-color: #f1f5f9;
      border-radius: 8px;
      padding: 20px 16px;
      text-align: center;
      margin: 32px 0;
      border: 1px dashed #cbd5e1;
    }

    .code {
      font-family: 'SFMono-Regular', Consolas, 'Liberation Mono', Menlo, monospace;
      font-size: 32px;
      font-weight: 700;
      letter-spacing: 6px;
      color: #dc2626;
      /* Warning red to denote a sensitive security operation */
    }

    .divider {
      border: 0;
      border-top: 1px solid #e2e8f0;
      margin: 32px 0 24px 0;
    }

    .footer-text {
      font-size: 13px;
      line-height: 1.5;
      color: #94a3b8;
      margin: 0;
    }
  </style>
</head>

<body>

  <table class="wrapper" width="100%" role="presentation">
    <tr>
      <td align="center">
        <table class="container" role="presentation">
          <tr>
            <td class="content">

              <div class="logo">YourApp</div>

              <h1 class="title">Reset your password</h1>

              <p class="text">Hi {{username}},</p>

              <p class="text">
                We received a request to reset the password for your account. Please enter the verification code below
                into the password recovery screen to proceed:
              </p>

              <!-- Main OTP block -->
              <div class="code-container">
                <span class="code">{{otp}}</span>
              </div>

              <p class="text" style="font-size: 14px; color: #64748b; margin-bottom: 0;">
                <strong>Note:</strong> This code will expire in a short window for security reasons. If you didn't ask
                for a password change, you can completely ignore this email and your password will remain exactly as it
                is.
              </p>

              <hr class="divider">

              <p class="footer-text">
                This is a secure automated notification regarding your account credentials.<br>
                &copy; 2026 YourApp. All rights reserved.
              </p>

            </td>
          </tr>
        </table>
      </td>
    </tr>
  </table>

</body>

</html>